/* ==========================================================================
   Red Accent Theme for GTK4 / libadwaita - Polished & Junk-Free
   ========================================================================== */

/* --------------------------------------------------------------------------
   0. THEME-ONLY COLORS
   (accent/window/view/headerbar/etc. are already set above — not redefined
   here anymore, this used to duplicate them and trigger GTK "color defined
   multiple times" warnings)
   -------------------------------------------------------------------------- */
@define-color hover_overlay rgba(255, 0, 0, 0.16);
@define-color press_overlay rgba(255, 0, 0, 0.28);
@define-color focus_ring_color #ff5c4d;

@define-color sidebar_bg_color #000000;
@define-color sidebar_fg_color #ffffff;
@define-color sidebar_border_color rgba(255, 0, 0, 0.5);

@define-color border_color rgba(255, 255, 255, 0.09);

/* --------------------------------------------------------------------------
   1. HEADERBAR
   -------------------------------------------------------------------------- */
headerbar {
    background-color: @headerbar_bg_color;
    border-bottom: 1px solid @headerbar_border_color;
}

headerbar viewswitcher button,
headerbar stackswitcher button {
    border-radius: 99px;
    background-image: none;
    transition: background-color 120ms ease;
}

/* --------------------------------------------------------------------------
   2. BUTTONS & SELECTION LOCK
   -------------------------------------------------------------------------- */
/* Base unselected state */
button {
    border-radius: 99px;
    background-color: #000000;
    transition: background-color 120ms ease;
}

/* Hover and Press for unselected buttons */
button:hover {
    background-color: @hover_overlay;
}

button:active {
    background-color: @accent_bg_color;
    color: @accent_fg_color;
}

/* LOCKED SELECTED STATE: Overrides hover/active flicker */
button:checked,
button:checked:hover,
button:checked:active,
headerbar viewswitcher button:checked,
headerbar viewswitcher button:checked:hover,
headerbar viewswitcher button:checked:active {
    background-color: @accent_bg_color;
    color: @accent_fg_color;
    background-image: none;
}

/* EXCEPTION 1: Color Select Buttons (Square, not roundy)
   Added 'window' for specificity instead of !important */
window colorbutton > button,
window button.color {
    border-radius: 8px;
    min-width: 24px;
    min-height: 24px;
}

/* EXCEPTION 2: "Apply" / Suggested Action Button (ALWAYS OPAQUE RED)
   Added 'window' for specificity instead of !important */
window button.suggested-action,
window button.suggested-action:hover,
window button.suggested-action:active {
    background-color: @accent_bg_color;
    color: @accent_fg_color;
    border: none;
    background-image: none;
}

/* --------------------------------------------------------------------------
   3. LINKED BUTTONS (Half-Roundy)
   -------------------------------------------------------------------------- */
.linked > button,
box.linked > button {
    border-radius: 0;
    border-right: 1px solid @border_color;
    margin: 0;
}

.linked > button:last-child,
box.linked > button:last-child {
    border-right: none;
}

/* Horizontal rounding */
.linked:not(.vertical) > button:first-child,
box.linked.horizontal > button:first-child {
    border-top-left-radius: 99px;
    border-bottom-left-radius: 99px;
}

.linked:not(.vertical) > button:last-child,
box.linked.horizontal > button:last-child {
    border-top-right-radius: 99px;
    border-bottom-right-radius: 99px;
}

/* Vertical divider fix: switch every vertical-linked button from a
   right-side divider to a bottom divider, THEN round/clear the edges.
   Previously only :first-child/:last-child were patched, so any middle
   button in a group of 3+ kept a stray right border and had no divider
   at all between it and its neighbors. */
.linked.vertical > button,
box.linked.vertical > button {
    border-right: none;
    border-bottom: 1px solid @border_color;
}

.linked.vertical > button:first-child,
box.linked.vertical > button:first-child {
    border-top-left-radius: 99px;
    border-top-right-radius: 99px;
}

.linked.vertical > button:last-child,
box.linked.vertical > button:last-child {
    border-bottom-left-radius: 99px;
    border-bottom-right-radius: 99px;
    border-bottom: none;
}

/* --------------------------------------------------------------------------
   4. TEXT BOXES, INPUTS & SWITCHES
   -------------------------------------------------------------------------- */
/* Multiline Text Boxes (Like the Custom CSS area) */
textview,
textview text {
    background-color: #000000;
    color: #ffffff;
}

/* Single-line inputs & wrappers get the red border and black background */
window entry,
window spinbutton,
window searchentry,
scrolledwindow.frame {
    background-color: #000000;
    border: 1px solid @accent_bg_color;
}

/* Keep single-line inputs roundy */
window entry,
window spinbutton,
window searchentry {
    border-radius: 99px;
    padding: 6px 14px;
}

/* Checkboxes and switches */
checkbutton check,
radio,
switch {
    background-color: #000000;
    border-radius: 99px;
}

checkbutton check:checked,
checkbutton check:checked:hover,
radio:checked,
radio:checked:hover,
switch:checked,
switch:checked:hover {
    background-color: @accent_bg_color;
    border-color: @accent_bg_color;
}

/* --------------------------------------------------------------------------
   5. LISTS & SIDEBAR
   -------------------------------------------------------------------------- */
.boxed-list {
    border-radius: 24px;
    background-color: #000000;
    border: 1px solid @border_color;
}

.boxed-list row.activatable:hover {
    background-color: @hover_overlay;
}

.boxed-list row.activatable:active {
    background-color: @accent_bg_color;
}

.navigation-sidebar row {
    border-radius: 99px;
    background-color: transparent;
    margin: 2px 8px;
}

.navigation-sidebar row:hover {
    background-color: @hover_overlay;
}

/* Locked sidebar selection */
.navigation-sidebar row:selected,
.navigation-sidebar row:selected:hover {
    background-color: @accent_bg_color;
    color: #ffffff;
}


/* ==========================================================================
   6. BARRAS DE VOLUME E PROGRESSO (SLIDERS / SCALES) - OPÇÃO B
   ========================================================================== */
/* Transforma a barra guia em um bloco largo e arredondado (estilo iOS/Android) */
scale trough,
scale trough highlight {
    min-height: 24px;
    border-radius: 99px;
}

scale slider {
    min-width: 8px;
    min-height: 16px;
    border-radius: 99px;
    background-color: #ffffff;
    box-shadow: none;
    border: none;
    margin: 0px;
}

/* GNOME Settings > Sound > Output Volume slider.
   Positional hack — breaks if row order changes. Intentionally left as-is:
   this slider is meant to have no visible dot (0px). */
window.background scale:nth-child(2) slider {
    min-width: 0px;
    min-height: 0px;
}

/* MOUSE EM CIMA (SEM CLICAR): O bloco preenchido acende em vermelho semi-transparente */
scale:hover highlight {
    background-image: none;
    background-color: @hover_overlay;
}

/* CLICADO/ARRASTANDO: O bloco preenchido vira vermelho opaco total */
scale:active highlight {
    background-image: none;
    background-color: @accent_bg_color;
}
