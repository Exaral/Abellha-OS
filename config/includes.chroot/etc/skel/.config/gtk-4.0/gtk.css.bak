/* ==========================================================================
   Base color palette (reference — Adwaita variable names, red-accent values)
   ========================================================================== */
@define-color accent_color #ff0000;
@define-color accent_bg_color #ff0000;
@define-color accent_fg_color #ffffff;
@define-color destructive_color rgb(255,90,90); /* was identical to accent_color; now distinguishable, still red-family */
@define-color destructive_bg_color #ff7b63;
@define-color destructive_fg_color #ffffff;
@define-color success_color #8ff0a4;
@define-color success_bg_color #26a269;
@define-color success_fg_color #ffffff;
